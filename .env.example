# Public URL used by the application shell. Keep local secrets in .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project values from the Supabase Connect panel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never add secret or service-role keys to a NEXT_PUBLIC_* variable.

# Server-only OpenAI configuration. Never expose the API key to browser code.
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-5.6-luna

# Controlled beta layer. Keep observe until the final identity/access flow is approved.
BETA_ACCESS_MODE=observe
BETA_SUPER_ADMIN_EMAILS=waxas.arshad@gmail.com
BETA_CONTACT_NAME=Waqas Arshad
BETA_CONTACT_PHONE=+92 345 809 536
BETA_CONTACT_EMAIL=waxas.arshad@gmail.com
BETA_CONTACT_HANDLE=waxas.arshad

# Server-only admin access. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

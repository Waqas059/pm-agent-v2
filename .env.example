# Public URL used by the application shell. Keep local secrets in .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project values from the Supabase Connect panel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Never add secret or service-role keys to a NEXT_PUBLIC_* variable.

# Server-only OpenAI configuration. Never expose the API key to browser code.
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-5.6
